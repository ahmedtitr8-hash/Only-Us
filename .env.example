# ==== إعدادات السيرفر ====
PORT=3000

# مفتاح بسيط لحماية الـ API (غيّره لأي نص سري تختاره)
API_KEY=setNote8

# ==== أسماء الأنديه (تظهر بالواجهة وتُستخدم كمجلد بالتخزين) ====
CLUB1_NAME=milan
CLUB2_NAME=barcelona

# ==== Backblaze B2 (بدون بطاقة ائتمان) ====
# من لوحة Backblaze: B2 Cloud Storage > App Keys > Add a New Application Key
B2_KEY_ID=0052d578e97c0590000000001
B2_APPLICATION_KEY=K005gZ3aWWLeA7O6sxoHuuowoCDwGns
# ⚠️ لسا ما عطيتني اسم الـ bucket الحقيقي اللي أنشأته — عدّل هذا السطر يدوي
B2_BUCKET_NAME=stream-zone-1937
# ⚠️ لسا ما عطيتني الـ Endpoint الحقيقي من صفحة الـ bucket — عدّل هذا السطر يدوي (بدون https://)
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
# ⚠️ جزء المنطقة (بين s3. و .backblazeb2.com) — عدّل هذا السطر يدوي لو مختلف
B2_REGION=us-east-005

# الـ bucket خاص (Private)، فكل رابط مؤقت وصالح لهذي المدة بالأيام
SIGNED_URL_EXPIRY_DAYS=7

# ==== إعدادات التسجيل ====
# أقصى مدة تسجيل مسموحة بالساعات لو ما حددت وقت إيقاف مجدول (حماية تلقائية لو نسيت توقف التسجيل)
MAX_RECORDING_HOURS=5

# أقصى عدد تسجيلات تشتغل بنفس اللحظة (بين الناديين مجتمعين)
MAX_CONCURRENT_RECORDINGS=2

# مساحة B2 المجانية التقريبية بالجيجا (لعرض شريط الاستهلاك بالواجهة فقط، ما يمنع الرفع)
B2_QUOTA_GB=10

# مجلد مؤقت لتخزين الملف أثناء التسجيل قبل رفعه (يُنشأ تلقائيًا)
TEMP_DIR=./temp

# ==== تنبيهات تيليجرام (اختياري تمامًا — اتركهم فاضيين لو ما تبي تنبيهات) ====
# 1) كلم @BotFather بتيليجرام وسوّي /newbot، ينسخ لك التوكن
# 2) كلم @userinfobot عشان يعطيك رقم الـ Chat ID حقك
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# كل كم دقيقة يرسل تحديث "لسا يسجل بدون مشاكل" لكل تسجيل شغال
TELEGRAM_STATUS_INTERVAL_MINUTES=5
# قبل كم دقيقة من موعد التسجيل المجدول يُرسل تذكير
TELEGRAM_REMINDER_MINUTES_BEFORE=10
